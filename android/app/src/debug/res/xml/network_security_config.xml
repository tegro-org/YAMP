<?xml version="1.0" encoding="utf-8"?>
<!--
   Debug builds only: the release config (src/main/res/xml/network_security_config.xml) plus plain HTTP to a local
   Jellyfin test server (scripts/jellyfin-dev/: the emulator reaches the host as 10.0.2.2). Keep the radio list in sync
   with the release file. Release builds stay HTTPS-only (docs/phase-3-providers.md §5).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">hostingradio.ru</domain>
        <domain includeSubdomains="true">cdnvideo.ru</domain>
        <domain includeSubdomains="true">streamr.ru</domain>
        <domain includeSubdomains="true">loveradio.ru</domain>
        <domain includeSubdomains="true">radiodacha.ru</domain>
        <domain includeSubdomains="false">23.105.238.4</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
