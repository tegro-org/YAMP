<?xml version="1.0" encoding="utf-8"?>
<!-- What the «Плеер» widget looks like in the list of widgets (Android 11 and older; newer draw it live) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="0" android:startColor="#3A4152" android:endColor="#10121A" />
            <size android:width="320dp" android:height="160dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:bottom="16dp" android:width="128dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1C2130" />
        </shape>
    </item>
    <item android:left="160dp" android:top="48dp" android:right="24dp" android:height="14dp">
        <shape android:shape="rectangle"><corners android:radius="7dp" /><solid android:color="#F4F6FA" /></shape>
    </item>
    <item android:left="160dp" android:top="72dp" android:right="72dp" android:height="10dp">
        <shape android:shape="rectangle"><corners android:radius="5dp" /><solid android:color="#A8FFFFFF" /></shape>
    </item>
    <item android:left="214dp" android:top="100dp" android:width="44dp" android:height="44dp">
        <shape android:shape="oval"><solid android:color="#F4F6FA" /></shape>
    </item>
</layer-list>
