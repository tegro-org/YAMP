<?xml version="1.0" encoding="utf-8"?>
<!-- What the «Строка» widget looks like in the list of widgets (Android 11 and older; newer draw it live) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#10121A" />
            <size android:width="300dp" android:height="68dp" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:width="52dp" android:height="52dp">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#3A4152" /></shape>
    </item>
    <item android:left="72dp" android:top="20dp" android:width="120dp" android:height="12dp">
        <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="#F4F6FA" /></shape>
    </item>
    <item android:left="72dp" android:top="38dp" android:width="80dp" android:height="8dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="#A8FFFFFF" /></shape>
    </item>
    <item android:left="240dp" android:top="8dp" android:width="52dp" android:height="52dp">
        <shape android:shape="oval"><solid android:color="#F4F6FA" /></shape>
    </item>
</layer-list>
